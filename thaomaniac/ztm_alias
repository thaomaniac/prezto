# Switch php version
switchphp() {
    if [ -z "$1" ]; then
        sudo update-alternatives --config php
    else
        sudo update-alternatives --set php /usr/bin/php"$1"
    fi

}

# Restart service
restart-service() {
    sudo service $1 restart
}

##----------GIT command----------##

# git commit with branch name as prefix
# commit message must be enclosed in quotation marks
commit() {
    if [ -z $vcs_info_msg_0_ ]; then
        echo "\e[1;31mUnknown branch name\e[0m"
        return 1;
    fi
    if [[ $# != 1 ]]; then
        echo "\e[1;31mTypeScript Error:\e[0m Expected 1 arguments, but got $#!"
        return 1;
    else
        local msg=$(echo $1 | cut -c1 | tr a-z A-Z)$(echo $1 | cut -c2-)
        git commit -m "$vcs_info_msg_0_: $msg"
    fi
}

# git push --set-upstream origin <branch>
pushsetupstream() {
    if [ "$vcs_info_msg_0_" = "" ]; then
        echo "\e[1;31mUnknown branch name\e[0m"
        return 1;
    else
        git push --set-upstream origin $vcs_info_msg_0_
    fi
}

