#---Alias with Nginx multiple php
m2() {
	eval $(phpVer) bin/magento "$@"
}
alias cc='eval $(phpVer) bin/magento cache:clean'
alias cf='eval $(phpVer) bin/magento cache:flush'
alias sdc='eval $(phpVer) bin/magento setup:di:compile'
alias ssd='eval $(phpVer) bin/magento setup:static-content:deploy'
alias seup='eval $(phpVer) bin/magento setup:upgrade'

phpVer() {
    if [ ! -f "$PWD/bin/magento" ]; then
        echo "php"
        return
    fi

    for ver in '' 7.4 7.3 8.1
    do
        magentoVer=$(php$ver bin/magento -V | tail -n 1 | awk '{print $NF}' | cut -c1-5) > /dev/null 2>&1
        if [[ $magentoVer =~ ^[0-9]+(\.[0-9]+){2,3}$ ]]; then
           break
        fi
    done

    case $magentoVer in
        '2.3.5'|'2.3.6')
            echo 'php7.3'
        ;;
        '2.3.7'|'2.4.0'|'2.4.1'|'2.4.2'|'2.4.3')
            echo 'php7.4'
        ;;
        '2.4.4')
            echo 'php8.1'
        ;;
        *)
            echo 'php'
        ;;
    esac
}

