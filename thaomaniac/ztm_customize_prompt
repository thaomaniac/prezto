###----------Agnoster theme - Rewrite Prompt components----------###

# End the prompt, closing any open segments
prompt_end() {
  if [[ -n $CURRENT_BG ]]; then
    #print -n "%{%k%F{$CURRENT_BG}%} $"
    print -n "%{%k%F{green}%} ❯$prompt_newline❯%B_%b"
  else
    print -n "%{%k%}"
  fi
  print -n "%{%f%}"
  CURRENT_BG=''
}

# Context: user@hostname (who am I and where am I)
prompt_context() {
  if [[ "$USER" != "$DEFAULT_USER" || -n "$SSH_CLIENT" ]]; then
    #prompt_segment $PRIMARY_FG default " %(!.%{%F{yellow}%}.)$USER@%m "
    prompt_segment default green "%(!.%{%F{white}%}.)❮"
  fi
}
#➜

# Git: branch/detached head, dirty status
prompt_git() {
  local color ref
  is_dirty() {
    test -n "$(git status --porcelain --ignore-submodules)"
  }
  ref="$vcs_info_msg_0_"
  if [[ -n "$ref" ]]; then
    if is_dirty; then
      color=yellow
      ref="${ref} $PLUSMINUS"
    else
      color=green
      ref="%B${ref}%b \U2714"
    fi
    if [[ "${ref/.../}" == "$ref" ]]; then
      ref="$BRANCH $ref"
    else
      ref="$DETACHED ${ref/.../}"
    fi
    prompt_segment default $color
    print -n " $ref"
  fi
}

# Dir: current working directory
prompt_dir() {
  prompt_segment default default ' %~'
  #prompt_segment default default ' %4c'
}

# Status:
# - was there an error
# - am I root
# - are there background jobs?
prompt_status() {
  local symbols
  symbols=()
  [[ $RETVAL -ne 0 ]] && symbols+="%{%F{default}%}$CROSS $CROSS $CROSS"
  [[ $UID -eq 0 ]] && symbols+="%{%F{yellow}%}$LIGHTNING"
  [[ $(jobs -l | wc -l) -gt 0 ]] && symbols+="%{%F{cyan}%}$GEAR"

  [[ -n "$symbols" ]] && prompt_segment default default "$symbols\n"
}

